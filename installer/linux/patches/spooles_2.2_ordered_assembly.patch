 /*--------------------------------------------------------------------*/
+
+/*
+   ----------------------------------------------------------------------
+   FEA Studio change, 21. 11. 2026 (threaded factorization): accumulate the updates to
+   front J in the ORDER OF THE UPDATE LIST (ascending source fronts, see
+   FrontMtx_factorSetup): the updates are taken from the head of the list
+   while the source front is finished; the first source that is not
+   finished stops the loop and the rest of the list stays as it is. The
+   order of the sums - and the round-off - does not depend on the order in
+   which the sources finish (FrontMtx_update takes the finished ones in
+   any order and reverses the list that is left).
+   ----------------------------------------------------------------------
+*/
+void
+FrontMtx_updateOrdered (
+   FrontMtx   *frontmtx,
+   Chv        *frontJ,
+   IP         *heads[],
+   char       status[],
+   DV         *tempDV,
+   int        msglvl,
+   FILE       *msgFile
+) {
+SubMtx   *mtxD, *mtxL, *mtxU ;
+int      I, J, nfront ;
+IP       *first, *ip, *last, *nextip ;
+
+J = frontJ->id ;
+nfront = frontmtx->nfront ;
+first = last = NULL ;
+for ( ip = heads[J] ; ip != NULL ; ip = nextip ) {
+   I = ip->val ;
+   if ( status != NULL && status[I] != 'F' ) {
+      break ;
+   }
+   nextip = ip->next ;
+   mtxD = FrontMtx_diagMtx(frontmtx, I) ;
+   if ( mtxD != NULL ) {
+      mtxU = FrontMtx_upperMtx(frontmtx, I, nfront) ;
+      if ( mtxU != NULL ) {
+         if ( FRONTMTX_IS_SYMMETRIC(frontmtx) ) {
+            Chv_updateS(frontJ, mtxD, mtxU, tempDV) ;
+         } else if ( FRONTMTX_IS_HERMITIAN(frontmtx) ) {
+            Chv_updateH(frontJ, mtxD, mtxU, tempDV) ;
+         } else if ( FRONTMTX_IS_NONSYMMETRIC(frontmtx) ) {
+            mtxL = FrontMtx_lowerMtx(frontmtx, nfront, I) ;
+            if ( mtxL != NULL ) {
+               Chv_updateN(frontJ, mtxL, mtxD, mtxU, tempDV) ;
+            }
+         }
+      }
+   }
+   if ( last == NULL ) {
+      last = ip ;
+   }
+   ip->next = first ;
+   first    = ip    ;
+}
+heads[J] = ip ;
+if ( last != NULL ) {
+/*
+   ------------------------------------
+   link the IP objects to the free list
+   ------------------------------------
+*/
+   last->next = heads[nfront] ;
+   heads[nfront] = first ;
+}
+return ; }
