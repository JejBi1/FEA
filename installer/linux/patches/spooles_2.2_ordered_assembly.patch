+/*--------------------------------------------------------------------*/
+/*
+   FEA Studio change, 21. 11. 2026: the owner of a list reports
+   that it has assembled n chevrons that ChvList_getList gave to it
+*/
+void
+ChvList_noteAssembled (
+   ChvList   *chvlist,
+   int       n
+) {
+if ( chvlist == NULL ) {
+   fprintf(stderr, "\n fatal error in ChvList_noteAssembled(%p,%d)"
+           "\n bad input\n", chvlist, n) ;
+   exit(-1) ;
+}
+if ( chvlist->lock != NULL ) {
+   Lock_lock(chvlist->lock) ;
+   chvlist->nassembled += n ;
+   Lock_unlock(chvlist->lock) ;
+} else {
+   chvlist->nassembled += n ;
+}
+return ; }
+
+/*--------------------------------------------------------------------*/
+/*
+   FEA Studio change, 21. 11. 2026: conservation check at the end of
+   a factorization (all threads are joined): returns the number of lists
+   that still have a count != 0 or a chevron (the list skipList excepted),
+   plus 1 when checkAssembled != 0 and the numbers of the chevrons that were
+   added, taken and assembled are not all equal
+*/
+int
+ChvList_closeCheck (
+   ChvList   *chvlist,
+   int       skipList,
+   int       checkAssembled
+) {
+int   ilist, nbad = 0 ;
+
+if ( chvlist == NULL ) {
+   fprintf(stderr, "\n fatal error in ChvList_closeCheck(%p)"
+           "\n bad input\n", chvlist) ;
+   exit(-1) ;
+}
+if ( chvlist->lock != NULL ) {
+   Lock_lock(chvlist->lock) ;
+}
+for ( ilist = 0 ; ilist < chvlist->nlist ; ilist++ ) {
+   if ( ilist == skipList ) {
+      continue ;
+   }
+   if ( chvlist->heads[ilist] != NULL
+     || (chvlist->counts != NULL && chvlist->counts[ilist] != 0) ) {
+      nbad++ ;
+   }
+}
+if ( checkAssembled != 0
+  && (chvlist->nadded != chvlist->ntaken
+   || chvlist->nadded != chvlist->nassembled) ) {
+   nbad++ ;
+}
+if ( chvlist->lock != NULL ) {
+   Lock_unlock(chvlist->lock) ;
+}
+return(nbad) ; }
