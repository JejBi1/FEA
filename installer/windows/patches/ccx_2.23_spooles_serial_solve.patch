+/* row-wise backward error of the factorization in p for a fixed pseudo random
+   right hand side (|b_i| between 0.25 and 1); -1. if it could not be checked
+   (no memory) */
+
+static double fea_check_factor(struct factorinfo *p,
+	double *ad,double *au,double *adb,double *aub,double *sigma,
+	ITG *icol,ITG *irow,ITG *neq,ITG *nzs,int symmetryflagi4,
+	ITG *inputformat,ITG ioff)
+{
+	int size=*neq,i;
+	unsigned int seed=12345u;
+	double *b0,*x0,*y,*rs,d,eta=0.,e;
+	DenseMtx *mtxB,*mtxX;
+
+	if(size<1) return 0.;
+	b0=(double *)malloc(size*sizeof(double));
+	x0=(double *)malloc(size*sizeof(double));
+	y=(double *)calloc(size,sizeof(double));
+	rs=(double *)calloc(size,sizeof(double));
+	if((b0==NULL)||(x0==NULL)||(y==NULL)||(rs==NULL)){
+		free(b0);free(x0);free(y);free(rs);
+		return -1.;
+	}
+	for(i=0;i<size;i++){
+		seed=seed*1103515245u+12345u;
+		d=0.25+0.75*(((seed>>8)&0xffff)/65536.);
+		seed=seed*1103515245u+12345u;
+		b0[i]=((seed>>16)&1u)?d:-d;
+	}
+	mtxB=DenseMtx_new();
+	DenseMtx_init(mtxB,SPOOLES_REAL,0,0,size,1,1,size);
+	DenseMtx_zero(mtxB);
+	for(i=0;i<size;i++) DenseMtx_setRealEntry(mtxB,i,0,b0[i]);
+	mtxX=fsolve_MT(p,mtxB);
+	for(i=0;i<size;i++) x0[i]=DenseMtx_entries(mtxX)[i];
+	DenseMtx_free(mtxX);
+	fea_matvec(ad,au,adb,aub,sigma,icol,irow,neq,nzs,symmetryflagi4,
+		   inputformat,ioff,x0,y,rs);
+	for(i=0;i<size;i++){
+		e=fabs(y[i]-b0[i])/(rs[i]+fabs(b0[i]));
+		if(e!=e) e=1.e300;
+		if(e>eta) eta=e;
+	}
+	free(b0);free(x0);free(y);free(rs);
+	return eta;
+}
