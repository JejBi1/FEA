+/* the verdict on a factorization. attempt = 0, 1: multi-threaded factorizations
+   (nthread threads), 2: the factorization on ONE thread after two failures.
+   Returns 1 when the system must be factorized again (the factors are freed),
+   0 when the factors are accepted.
+   FEA Studio change, 23. 11. 2026 (order of the decisions, after a review): a violation of the bookkeeping of
+   SPOOLES (error -2, `bad`) is evidence by itself and is judged BEFORE any off-switch
+   (the static flag fea_check_off that an earlier matrix set, and FEA_SPOOLES_CHECK_TOL=0),
+   then the test solve; a repeat is called "confirmed" only when its test solve was
+   done and passed - when the test solve could not be done (no memory), the repeat is
+   used without a verdict and the log says so. */
+
+static int fea_judge(struct factorinfo *p,int attempt,int nthread,
+	double *ad,double *au,double *adb,double *aub,double *sigma,
+	ITG *icol,ITG *irow,ITG *neq,ITG *nzs,int symmetryflagi4,
+	ITG *inputformat,ITG ioff)
+{
+	double tol=fea_check_tol(),eta=0.;
+	int bad=fea_agg_violation,off,unchecked=0;
+
+	fea_agg_violation=0;
+	if(attempt>=2) bad=0;               /* one thread: no hand-over, nothing to violate */
+	off=((fea_check_off)||(tol<=0.));
+	if((off)&&(!bad)) return 0;
+	if(!off){
+		eta=fea_check_factor(p,ad,au,adb,aub,sigma,icol,irow,neq,nzs,
+				     symmetryflagi4,inputformat,ioff);
+		if(eta<0.){
+			unchecked=1;            /* no verdict from the test solve (the bookkeeping flag still counts) */
+			eta=0.;
+			if(attempt==0){
+				printf(" *WARNING in spooles: the factors could not be checked (not enough memory for the test solve).\n%s",bad?"":"\n");
+			}else{
+				printf(" *WARNING in spooles: the factors of the repeated factorization could not be checked (not enough memory for the test solve).\n");
+			}
+		}
+	}
+	if(attempt>=2){
+		if(unchecked){
+			printf("                      The factorization on ONE thread is used without a verdict: a loss in the threads is NOT confirmed.\n\n");
+		}else if(eta>tol){
+			printf(" *WARNING in spooles: the factorization on ONE thread fails the check as well (relative residual of a test solve %.3e, limit %.1e):\n"
+			       "                      the matrix, not the threads, is the cause (nearly singular or very badly scaled system of equations). The factors are used\n"
+			       "                      as they are; the check is switched off for the rest of this run and the later factorizations run on ONE thread.\n\n",eta,tol);
+			fea_check_off=1;
+		}else{
+			printf("                      The factorization on ONE thread passes the check (relative residual %.3e): threaded loss confirmed.\n\n",eta);
+		}
+		return 0;
+	}
+	if((eta>tol)||(bad)){
+		if(off){
+			printf(" *WARNING in spooles: the multi-threaded factorization failed the check of its result (the bookkeeping of the hand-over between the threads is violated; the test solve of the factors is switched off).\n");
+		}else if(unchecked){
+			printf(" *WARNING in spooles: the multi-threaded factorization failed the check of its result (the bookkeeping of the hand-over between the threads is violated; the test solve of the factors could not be done).\n");
+		}else{
+			printf(" *WARNING in spooles: the multi-threaded factorization failed the check of its result (relative residual of a test solve %.3e, limit %.1e%s).\n",
+			       eta,tol,bad?"; the bookkeeping of the hand-over between the threads is violated":"");
+		}
+		fea_free_factor(p);
+		if(attempt==0){
+			printf("                      The system of equations is factorized again with %d threads.\n\n",nthread);
+		}else{
+			printf("                      The system of equations is factorized again with ONE thread.\n\n");
+		}
+		return 1;
+	}
+	if(attempt==1){
+		if(unchecked){
+			printf("                      The repeated multi-threaded factorization is used without a verdict: a loss in the threads is NOT confirmed.\n\n");
+		}else{
+			printf("                      The repeated multi-threaded factorization passes the check (relative residual %.3e): threaded loss confirmed.\n\n",eta);
+		}
+	}
+	return 0;
+}
